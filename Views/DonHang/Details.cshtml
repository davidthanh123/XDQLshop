@model DonHang
@{
    ViewData["Title"] = $"Chi tiết đơn {Model.MaDon}";

    string badgeColor = Model.TrangThai switch
    {
        TrangThaiDon.Moi => "bg-secondary",
        TrangThaiDon.DaXacNhan => "bg-primary",
        TrangThaiDon.DangDong => "bg-warning text-dark",
        TrangThaiDon.DaGiao => "bg-success",
        TrangThaiDon.Huy => "bg-danger",
        TrangThaiDon.Hoan => "bg-dark",
        _ => "bg-secondary"
    };

    string channelClass = Model.Kenh switch
    {
        KenhBan.TikTokShop => "channel-tiktok",
        KenhBan.Facebook => "channel-fb",
        KenhBan.Zalo => "channel-zalo",
        _ => "channel-pos"
    };
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h3 class="mb-0 fw-bold">
            <i class="bi bi-receipt me-2"></i>Đơn Hàng: <span class="text-primary font-monospace">@Model.MaDon</span>
            <span class="badge @badgeColor ms-2">@Model.TrangThai</span>
            <span class="badge badge-channel @channelClass ms-1">@Model.Kenh</span>
        </h3>
        <small class="text-muted">Ngày tạo: @Model.NgayTao.ToString("dd/MM/yyyy HH:mm") &bull; Người tạo: @Model.NguoiTao</small>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-success" asp-action="InVanDon" asp-route-id="@Model.Id" target="_blank">
            <i class="bi bi-printer-fill me-1"></i> In Phiếu Giao Hàng / Lưu PDF (CR-01)
        </a>
        <a class="btn btn-outline-secondary" asp-action="Index">
            <i class="bi bi-arrow-left me-1"></i> Quay lại
        </a>
    </div>
</div>

<div class="row g-3 mb-4">
    <!-- Customer Info -->
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-header bg-white fw-bold">
                <i class="bi bi-person-fill text-primary me-1"></i> Thông Tin Khách Hàng
            </div>
            <div class="card-body">
                <h5 class="fw-bold mb-1">@Model.KhachHang.HoTen</h5>
                <p class="mb-1"><i class="bi bi-telephone-fill text-muted me-1"></i> <strong>@Model.KhachHang.SoDienThoai</strong></p>
                <p class="mb-0 text-muted"><i class="bi bi-geo-alt-fill me-1"></i> @Model.KhachHang.DiaChi</p>
            </div>
        </div>
    </div>

    <!-- Shipping & Carrier Info -->
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-header bg-white fw-bold">
                <i class="bi bi-truck text-success me-1"></i> Vận Chuyển & Giao Hàng
            </div>
            <div class="card-body">
                <div class="d-flex justify-content-between mb-1">
                    <span class="text-muted">Đơn vị vận chuyển:</span>
                    <strong class="text-primary">@Model.DonViVanChuyen</strong>
                </div>
                <div class="d-flex justify-content-between mb-1">
                    <span class="text-muted">Mã vận đơn:</span>
                    <strong class="font-monospace">@(Model.MaVanDon ?? "Chưa khởi tạo")</strong>
                </div>
                <div class="d-flex justify-content-between mb-1">
                    <span class="text-muted">Tiền thu hộ COD:</span>
                    <strong class="text-danger fs-5">@Model.TienThuHo.ToString("N0") VNĐ</strong>
                </div>
                <div class="mt-2 p-2 bg-light rounded small">
                    <strong>Ghi chú giao:</strong> @(string.IsNullOrWhiteSpace(Model.GhiChu) ? "Không có" : Model.GhiChu)
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Order Line Items Table -->
<div class="card mb-4">
    <div class="card-header bg-white fw-bold d-flex justify-content-between">
        <span><i class="bi bi-box-seam text-warning me-1"></i> Danh Sách Sản Phẩm Trong Đơn</span>
        <span class="badge bg-secondary">@Model.ChiTiet.Sum(c => c.SoLuong) sản phẩm</span>
    </div>
    <div class="table-responsive">
        <table class="table table-bordered align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th style="width: 20%">Mã SKU</th>
                    <th>Tên Sản Phẩm</th>
                    <th>Size / Màu</th>
                    <th class="text-center" style="width: 10%">Số Lượng</th>
                    <th class="text-end" style="width: 18%">Đơn Giá</th>
                    <th class="text-end" style="width: 18%">Thành Tiền</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model.ChiTiet)
                {
                    <tr>
                        <td class="font-monospace fw-bold">@c.BienThe.MaSku</td>
                        <td>@c.BienThe.SanPham.TenSp</td>
                        <td>
                            <span class="badge bg-light text-dark border">@c.BienThe.Size</span>
                            <span class="badge bg-light text-dark border">@c.BienThe.MauSac</span>
                        </td>
                        <td class="text-center fw-bold">@c.SoLuong</td>
                        <td class="text-end">@c.DonGia.ToString("N0") đ</td>
                        <td class="text-end fw-bold text-dark">@((c.SoLuong * c.DonGia).ToString("N0")) đ</td>
                    </tr>
                }
            </tbody>
            <tfoot class="table-light">
                <tr>
                    <th colspan="5" class="text-end fs-6">Tổng Giá Trị Đơn Hàng:</th>
                    <th class="text-end text-danger fs-5 fw-bold">@Model.TongTien.ToString("N0") đ</th>
                </tr>
            </tfoot>
        </table>
    </div>
</div>

<!-- Status Workflow Control Panel -->
<div class="card p-3">
    <div class="fw-bold mb-2"><i class="bi bi-gear-fill me-1"></i> Xử Lý Trạng Thái Đơn Hàng (Theo Vòng Đời Nghiệp Vụ)</div>
    <div class="small text-muted mb-3">
        Luồng: <code>Mới &rarr; Đã xác nhận &rarr; Đang đóng gói &rarr; Đã giao</code>.
        Nếu chọn <strong>Hủy</strong> hoặc <strong>Hoàn</strong>, hệ thống sẽ tự động cộng lại tồn kho cho các SKU tương ứng và ghi nhận lịch sử biến động kho.
    </div>

    @if (Model.TrangThai is TrangThaiDon.Huy or TrangThaiDon.Hoan)
    {
        <div class="alert alert-secondary mb-0">
            <i class="bi bi-lock-fill me-1"></i> Đơn hàng đã ở trạng thái kết thúc (<strong>@Model.TrangThai</strong>). Tồn kho đã được hoàn trả về hệ thống.
        </div>
    }
    else
    {
        <form asp-action="DoiTrangThai" method="post" class="d-flex flex-wrap gap-2">
            <input type="hidden" name="id" value="@Model.Id" />

            @if (Model.TrangThai == TrangThaiDon.Moi && (User.IsInRole(VaiTro.ChuShop) || User.IsInRole(VaiTro.ChotDon)))
            {
                <button name="moi" value="DaXacNhan" class="btn btn-primary">
                    <i class="bi bi-check2-circle me-1"></i> Xác Nhận Đơn Hàng
                </button>
            }

            @if (Model.TrangThai == TrangThaiDon.DaXacNhan && (User.IsInRole(VaiTro.ChuShop) || User.IsInRole(VaiTro.Kho)))
            {
                <button name="moi" value="DangDong" class="btn btn-warning text-dark">
                    <i class="bi bi-box-seam me-1"></i> Chuyển Sang: Đang Đóng Gói
                </button>
            }

            @if (Model.TrangThai == TrangThaiDon.DangDong && (User.IsInRole(VaiTro.ChuShop) || User.IsInRole(VaiTro.Kho)))
            {
                <button name="moi" value="DaGiao" class="btn btn-success">
                    <i class="bi bi-truck me-1"></i> Đã Giao Cho ĐVVC
                </button>
            }

            @if (Model.TrangThai is TrangThaiDon.Moi or TrangThaiDon.DaXacNhan or TrangThaiDon.DangDong && (User.IsInRole(VaiTro.ChuShop) || User.IsInRole(VaiTro.ChotDon)))
            {
                <button name="moi" value="Huy" class="btn btn-outline-danger" onclick="return confirm('Bạn có chắc chắn muốn HỦY đơn này? Toàn bộ số lượng tồn kho sẽ được tự động hoàn lại!');">
                    <i class="bi bi-x-circle me-1"></i> Hủy Đơn (Tự động hoàn kho)
                </button>
            }

            @if (Model.TrangThai == TrangThaiDon.DaGiao && (User.IsInRole(VaiTro.ChuShop) || User.IsInRole(VaiTro.Kho)))
            {
                <button name="moi" value="Hoan" class="btn btn-outline-dark" onclick="return confirm('Xác nhận khách hoàn đơn hàng này? Số lượng tồn kho sẽ được cộng lại hệ thống!');">
                    <i class="bi bi-arrow-return-left me-1"></i> Khách Hoàn Hàng (Tự động hoàn kho)
                </button>
            }
        </form>
    }
</div>
