@{
    ViewData["Title"] = "Nhập Đơn Hàng Từ CSV";
}

<div class="row justify-content-center">
    <div class="col-lg-9">
        <div class="card p-4">
            <div class="d-flex justify-content-between align-items-center border-bottom pb-3 mb-3">
                <div>
                    <h3 class="fw-bold mb-0 text-success"><i class="bi bi-file-earmark-spreadsheet me-2"></i>Nhập Đơn Hàng Từ File CSV</h3>
                    <small class="text-muted">Hỗ trợ nhập hàng loạt đơn xuất từ TikTok Shop, Facebook Chatbot, Zalo OA</small>
                </div>
                <div class="d-flex gap-2">
                    <a class="btn btn-outline-primary btn-sm" asp-action="DownloadCsvTemplate">
                        <i class="bi bi-download me-1"></i> Tải File Mẫu (CSV)
                    </a>
                    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                        <i class="bi bi-arrow-left me-1"></i> Quay lại
                    </a>
                </div>
            </div>

            @if (ViewBag.Loi != null)
            {
                <div class="alert alert-danger">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i> @ViewBag.Loi
                </div>
            }

            @if (ViewBag.ThanhCong != null)
            {
                <div class="alert alert-success">
                    <i class="bi bi-check-circle-fill me-2"></i> <strong>Thành công:</strong> Đã tạo và trừ kho tức thì cho <strong>@ViewBag.ThanhCong</strong> đơn hàng!
                </div>
                var loiList = (List<string>)ViewBag.LoiList;
                if (loiList != null && loiList.Count > 0)
                {
                    <div class="card border-danger mb-3">
                        <div class="card-header bg-danger text-white fw-bold">
                            <i class="bi bi-x-circle me-1"></i> Danh Sách Dòng Không Nhập Được (@loiList.Count lỗi)
                        </div>
                        <div class="card-body p-2" style="max-height: 220px; overflow-y: auto;">
                            <ul class="mb-0 text-danger small">
                                @foreach (var l in loiList)
                                {
                                    <li>@l</li>
                                }
                            </ul>
                        </div>
                    </div>
                }
            }

            <div class="card bg-light p-3 mb-4">
                <h6 class="fw-bold mb-2"><i class="bi bi-info-circle me-1"></i> Định Dạng Cấu Trúc File CSV Chuẩn:</h6>
                <code class="d-block p-2 bg-white border rounded text-dark font-monospace mb-2">
                    MaSku,HoTen,SoDienThoai,DiaChi,SoLuong,Kenh,GhiChu,DonViVanChuyen
                </code>
                <div class="small text-muted">
                    &bull; <strong>Kenh</strong>: Một trong các giá trị: <code>TikTokShop</code>, <code>Facebook</code>, <code>Zalo</code>, <code>TrucTiep</code>.<br />
                    &bull; Mỗi dòng tương ứng 1 sản phẩm đặt mua. Hệ thống tự động kiểm tra tồn kho, nếu còn hàng sẽ trừ kho ngay; nếu hết hàng hoặc không đủ tồn kho, hệ thống sẽ chặn dòng đó và báo lỗi rõ ràng.
                </div>
            </div>

            <form method="post" enctype="multipart/form-data">
                <div class="mb-3">
                    <label class="form-label fw-bold">Chọn file dữ liệu CSV cần nhập (.csv):</label>
                    <input type="file" name="file" accept=".csv" class="form-control form-control-lg" required />
                </div>
                <div class="d-flex justify-content-end">
                    <button type="submit" class="btn btn-success px-4 py-2 fw-bold">
                        <i class="bi bi-cloud-arrow-up-fill me-1"></i> Tiến Hành Nhập & Trừ Kho Ngay
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
