@{
    ViewData["Title"] = "Nhập Kho Sản Phẩm";
    var skuList = (List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)ViewBag.Sku;
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card p-4">
            <div class="d-flex justify-content-between align-items-center border-bottom pb-3 mb-3">
                <div>
                    <h3 class="fw-bold mb-0 text-primary"><i class="bi bi-box-arrow-in-down me-2"></i>Tạo Phiếu Nhập Kho</h3>
                    <small class="text-muted">Nhập bổ sung nguồn hàng từ xưởng may hoặc nhà cung cấp</small>
                </div>
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left me-1"></i> Quay lại</a>
            </div>

            @if (ViewBag.Loi != null)
            {
                <div class="alert alert-danger">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i> @ViewBag.Loi
                </div>
            }

            <form method="post">
                <div class="mb-3">
                    <label class="form-label fw-bold">Chọn Mã SKU Biến Thể Cần Nhập <span class="text-danger">*</span></label>
                    <select name="bienTheId" class="form-select form-select-lg" asp-items="skuList" required></select>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold">Số Lượng Nhập Bổ Sung (Chiếc) <span class="text-danger">*</span></label>
                    <input name="soLuong" type="number" min="1" value="20" class="form-control form-control-lg fw-bold" required />
                </div>
                <div class="mb-4">
                    <label class="form-label fw-bold">Ghi Chú Nhập Kho (Nguồn hàng / Đợt sản xuất)</label>
                    <input name="ghiChu" class="form-control" placeholder="Ví dụ: Nhập bổ sung đợt 2 từ Xưởng may Hà Đông" value="Nhập bổ sung đợt hàng mới" />
                </div>
                <div class="d-flex justify-content-end">
                    <button type="submit" class="btn btn-primary px-4 py-2 fw-bold">
                        <i class="bi bi-check2-circle me-1"></i> Xác Nhận Nhập Kho (Cộng Tồn Ngay)
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
