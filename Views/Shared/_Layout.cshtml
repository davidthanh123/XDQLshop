<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Shop Quản Lý (Thời Trang Online)</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <style>
        body { background-color: #f8f9fa; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif; }
        .navbar-brand { font-weight: 700; letter-spacing: -0.5px; }
        .card { border-radius: 10px; border: 1px solid rgba(0,0,0,0.08); box-shadow: 0 2px 6px rgba(0,0,0,0.02); }
        .badge-channel { font-size: 0.75rem; padding: 4px 8px; border-radius: 6px; }
        .channel-tiktok { background-color: #000000; color: #ffffff; }
        .channel-fb { background-color: #1877f2; color: #ffffff; }
        .channel-zalo { background-color: #0068ff; color: #ffffff; }
        .channel-pos { background-color: #6c757d; color: #ffffff; }
        .kpi-card { border-left: 4px solid #0d6efd; }
        .kpi-success { border-left-color: #198754; }
        .kpi-warning { border-left-color: #ffc107; }
        .kpi-danger { border-left-color: #dc3545; }
        @@media print {
            .no-print { display: none !important; }
            body { background: #fff !important; }
            .container { max-width: 100% !important; padding: 0 !important; }
        }
    </style>
</head>
<body>
<nav class="navbar navbar-expand-lg navbar-dark bg-dark sticky-top no-print">
  <div class="container-fluid px-4">
    <a class="navbar-brand text-warning" asp-controller="Home" asp-action="Index">
      <i class="bi bi-bag-check-fill me-1"></i> FASHION OMS-WMS
    </a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navContent">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navContent">
      @if (User.Identity?.IsAuthenticated == true)
      {
        <ul class="navbar-nav me-auto mb-2 mb-lg-0">
          <li class="nav-item">
            <a class="nav-link" asp-controller="DonHang" asp-action="Index">
              <i class="bi bi-receipt me-1"></i> Đơn hàng
            </a>
          </li>
          @if (User.IsInRole(VaiTro.ChuShop) || User.IsInRole(VaiTro.ChotDon))
          {
            <li class="nav-item">
              <a class="nav-link" asp-controller="DonHang" asp-action="Create">
                <i class="bi bi-plus-circle me-1"></i> Tạo đơn
              </a>
            </li>
            <li class="nav-item">
              <a class="nav-link" asp-controller="DonHang" asp-action="ImportCsv">
                <i class="bi bi-file-earmark-spreadsheet me-1"></i> Nhập CSV (TikTok/FB)
              </a>
            </li>
          }
          @if (User.IsInRole(VaiTro.ChuShop) || User.IsInRole(VaiTro.Kho))
          {
            <li class="nav-item">
              <a class="nav-link" asp-controller="TonKho" asp-action="Index">
                <i class="bi bi-boxes me-1"></i> Quản lý kho
              </a>
            </li>
          }
          @if (User.IsInRole(VaiTro.ChuShop))
          {
            <li class="nav-item">
              <a class="nav-link" asp-controller="SanPham" asp-action="Index">
                <i class="bi bi-tags me-1"></i> Danh mục SP
              </a>
            </li>
            <li class="nav-item">
              <a class="nav-link" asp-controller="BaoCao" asp-action="Index">
                <i class="bi bi-graph-up-arrow me-1"></i> Báo cáo & Chốt ca
              </a>
            </li>
          }
          <li class="nav-item">
            <a class="nav-link text-info" asp-controller="DuAn" asp-action="Index">
              <i class="bi bi-kanban me-1"></i> Hồ sơ dự án (QLDA)
            </a>
          </li>
        </ul>
        <div class="d-flex align-items-center">
          @{
            string roleLabel = User.IsInRole(VaiTro.ChuShop) ? "Chủ Shop (Full)" :
                               User.IsInRole(VaiTro.ChotDon) ? "NV Chốt Đơn" : "NV Kho";
            string roleBadge = User.IsInRole(VaiTro.ChuShop) ? "bg-danger" :
                               User.IsInRole(VaiTro.ChotDon) ? "bg-primary" : "bg-warning text-dark";
          }
          <span class="text-light me-3">
            <i class="bi bi-person-circle me-1"></i>
            <strong>@User.Identity.Name</strong>
            <span class="badge @roleBadge ms-1">@roleLabel</span>
          </span>
          <a class="btn btn-sm btn-outline-light" asp-controller="Account" asp-action="Logout">
            <i class="bi bi-box-arrow-right me-1"></i> Đăng xuất
          </a>
        </div>
      }
      else
      {
        <ul class="navbar-nav ms-auto">
          <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Login">Đăng nhập</a></li>
        </ul>
      }
    </div>
  </div>
</nav>

<div class="container-fluid px-4 my-3">
  @if (TempData["ThongBao"] != null)
  {
    <div class="alert alert-success alert-dismissible fade show no-print" role="alert">
      <i class="bi bi-check-circle-fill me-2"></i> @TempData["ThongBao"]
      <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
  }
  @if (TempData["Loi"] != null)
  {
    <div class="alert alert-danger alert-dismissible fade show no-print" role="alert">
      <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["Loi"]
      <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
  }

  @RenderBody()
</div>

<footer class="footer mt-auto py-3 bg-white border-top text-center text-muted small no-print">
  <div class="container">
    Hệ thống Quản lý Đơn hàng & Tồn kho Shop Thời Trang Online &bull; Đồ án QLDA CNTT &bull; Kế hoạch 15+1 ngày &bull; Ngân sách 55M (CR 3.1M)
  </div>
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
