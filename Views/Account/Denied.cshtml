@{
    ViewData["Title"] = "Từ chối truy cập";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-6 text-center">
        <div class="card p-5 shadow-sm">
            <div class="text-danger mb-3">
                <i class="bi bi-shield-x" style="font-size: 4rem;"></i>
            </div>
            <h4 class="fw-bold text-dark">KHÔNG CÓ QUYỀN TRUY CẬP</h4>
            <p class="text-muted">
                Tài khoản hiện tại của bạn không được phân quyền để thao tác chức năng này theo ma trận phân quyền (RBAC) của hệ thống.
            </p>
            <div class="d-flex justify-content-center gap-2 mt-3">
                <a asp-controller="Home" asp-action="Index" class="btn btn-primary">
                    <i class="bi bi-house me-1"></i> Quay về trang chủ
                </a>
                <a asp-controller="Account" asp-action="Login" class="btn btn-outline-secondary">
                    <i class="bi bi-person me-1"></i> Đăng nhập tài khoản khác
                </a>
            </div>
        </div>
    </div>
</div>
